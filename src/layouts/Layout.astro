---
import { Toaster } from "@pheralb/toast";
import SessionWatcher from "../components/ui/SessionWatcher";
import "../styles/global.css";
import "../styles/navbar.css";
import type { Locals } from "astro";
import { isPublicRoute } from "../lib/authHelper";
import { publicRoutes } from "../lib/authConfig";

const user = (Astro.locals as Locals).user;
const userProfile = (Astro.locals as Locals).userProfile;
const hasRedil = userProfile?.redilId ?? user?.redil_id;
const pathname = Astro.url.pathname;
const isPublic = isPublicRoute(pathname, publicRoutes);
const isProtectedPage = Boolean(user) && !isPublic;

const navLinks = [
  { href: "/", label: "Dashboard", roles: ["Admin"] },
  { href: "/redil", label: "Rediles", roles: ["Admin"] },
  { href: "/teacher", label: "Profesores", roles: ["Admin"] },
  { href: "/class", label: "Clases", roles: ["Admin", "Maestro"] },
  { href: "/my-redil", label: "Mi Redil", roles: ["Admin", "Maestro"] },
];

const visibleLinks = navLinks.filter((item) => {
  if (item.roles.includes("Maestro") && !hasRedil) {
    return false;
  }

  if (user) {
    return item.roles.includes(user.role);
  }

  return false;
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo-comu.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Redil App</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        const token = localStorage.getItem("auth_token");
        if (token) {
          document.cookie = "access_token=" + token + "; path=/; max-age=86400; samesite=lax";
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-[#F4F6F9] font-sans text-gray-800 antialiased">
    {
      isProtectedPage && (
        <header class="sticky top-0 z-50 bg-[#003366] text-white shadow-md">
          <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4">
            <div class="flex items-center gap-6">
              <a href="/">
                <img src="/comu-app-logo.png" alt="logo" class="h-11 w-auto" />
              </a>

              <nav class="hidden items-center gap-1 md:flex">
                {visibleLinks.map((item) => (
                  <a
                    href={item.href}
                    class={`rounded-xl px-4 py-2 text-sm font-medium transition-colors ${
                      pathname === item.href
                        ? "bg-white/15 text-white"
                        : "text-blue-100 hover:bg-white/10 hover:text-white"
                    }`}
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
            </div>

            <div class="flex items-center gap-4">
              <div class="relative">
                <button
                  id="userMenuBtn"
                  class="flex items-center gap-2 rounded-xl p-1.5 transition-colors hover:bg-white/10"
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  <div class="hidden text-left sm:block">
                    <p class="text-xs leading-tight font-semibold">{user?.name || "Usuario"}</p>
                    <p class="text-[10px] leading-tight text-blue-200">{user?.role || "Rol"}</p>
                  </div>
                  <svg
                    class="chevron height-4 w-4 text-blue-200 transition-transform duration-200"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>

                <div
                  id="userDropdown"
                  class="absolute right-0 mt-2 hidden w-48 rounded-xl border border-gray-100 bg-white py-1 text-gray-700 shadow-lg [&.open]:block"
                >
                  <a href="/profile" class="block px-4 py-2.5 text-sm font-medium hover:bg-gray-50">
                    Mi Perfil
                  </a>
                  <div class="my-1 border-t border-gray-100" />
                  <button
                    id="logoutBtn"
                    class="block w-full px-4 py-2.5 text-left text-sm font-medium text-red-600 hover:bg-red-50"
                  >
                    Cerrar sesión
                  </button>
                </div>
              </div>

              <button
                id="hamburgerBtn"
                class="rounded-xl p-2 transition-colors hover:bg-white/10 md:hidden"
                aria-label="Abrir menú"
              >
                <svg
                  class="height-6 w-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 6h16M4 12h16M4 18h16"
                  />
                </svg>
              </button>
            </div>
          </div>

          <nav
            id="mobileNav"
            class="hidden space-y-1 border-t border-blue-900/50 bg-[#002b5c] px-4 py-2 shadow-inner md:hidden [&.open]:block"
          >
            {visibleLinks.map((item) => (
              <a
                href={item.href}
                class={`block rounded-xl px-4 py-2.5 text-sm font-medium transition-colors ${
                  pathname === item.href
                    ? "bg-white/15 text-white"
                    : "text-blue-100 hover:bg-white/5"
                }`}
              >
                {item.label}
              </a>
            ))}
            <hr class="my-2 border-blue-900/30" />
            <a
              href="/profile"
              class="block rounded-xl px-4 py-2.5 text-sm font-medium text-blue-100 transition-colors hover:bg-white/5"
            >
              Mi Perfil
            </a>
            <button
              id="logoutBtnMobile"
              class="block w-full rounded-xl px-4 py-2.5 text-left text-sm font-medium text-red-300 transition-colors hover:bg-white/5"
            >
              Cerrar sesión
            </button>
          </nav>
        </header>
      )
    }

    <main class="flex flex-grow flex-col">
      <slot />
    </main>

    <Toaster client:load position="top-right" />
    <SessionWatcher client:load />
  </body>
</html>

<script>
  const btn = document.getElementById("userMenuBtn");
  const dropdown = document.getElementById("userDropdown");
  const chevron = btn?.querySelector(".chevron");
  const hamburger = document.getElementById("hamburgerBtn");
  const mobileNav = document.getElementById("mobileNav");
  const logoutBtn = document.getElementById("logoutBtn");
  const logoutBtnMobile = document.getElementById("logoutBtnMobile");

  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    dropdown?.classList.toggle("open");
    chevron?.classList.toggle("rotate-180");
    const isOpen = dropdown?.classList.contains("open");
    btn.setAttribute("aria-expanded", String(isOpen));
  });

  document.addEventListener("click", () => {
    dropdown?.classList.remove("open");
    chevron?.classList.remove("rotate-180");
    btn?.setAttribute("aria-expanded", "false");
  });

  hamburger?.addEventListener("click", () => {
    mobileNav?.classList.toggle("open");
  });

  function logout() {
    localStorage.removeItem("auth_token");
    document.cookie = "access_token=; path=/; max-age=0";
    window.location.href = "/login";
  }

  logoutBtn?.addEventListener("click", logout);
  logoutBtnMobile?.addEventListener("click", logout);
</script>
