---
import { Toaster } from "@pheralb/toast";
import "../styles/global.css";
import type { Locals } from "astro";

const user = (Astro.locals as Locals).user;
const pathname = Astro.url.pathname;
const isProtectedPage = Boolean(user);

const navLinks = [
    { href: "/dashboard", label: "Dashboard", roles: ["Admin", "Maestro"] },
    { href: "/redil", label: "Rediles", roles: ["Admin"] },
    { href: "/teacher", label: "Profesores", roles: ["Admin"] },
    { href: "/class", label: "Clases", roles: ["Admin", "Maestro"] },
];

const visibleLinks = navLinks.filter((item) =>
    user ? item.roles.includes(user.role) : false
);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Redil App</title>
    </head>
    <body>
        {
            isProtectedPage && (
                <header class="app-navbar">
                    <div class="app-navbar-content">
                        <div class="app-navbar-left">
                            <a href="/dashboard" class="app-navbar-brand">Redil App</a>
                            <span class="app-role-chip">{user?.role}</span>
                        </div>
                        <nav class="app-navbar-links">
                            {visibleLinks.map((item) => (
                                <a
                                    href={item.href}
                                    class:list={[
                                        "app-navbar-link",
                                        { "app-navbar-link-active": pathname === item.href },
                                    ]}
                                >
                                    {item.label}
                                </a>
                            ))}
                        </nav>
                        <div class="app-navbar-actions">
                            <a
                                href="/profile"
                                class:list={[
                                    "btn-secondary app-action-button",
                                    { "app-navbar-link-active": pathname === "/profile" },
                                ]}
                            >
                                Perfil
                            </a>
                            <form method="post" action="/logout">
                                <button type="submit" class="btn-secondary app-action-button">
                                    Cerrar sesion
                                </button>
                            </form>
                        </div>
                    </div>
                </header>
            )
        }
        <slot />
        <Toaster client:load position="top-right" />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
