---
import { Toaster } from "@pheralb/toast";
import "../styles/global.css";
import "../styles/navbar.css";
import type { Locals } from "astro";
import { isPublicRoute } from "../lib/authHelper";
import { publicRoutes } from "../lib/authConfig";

const user = (Astro.locals as Locals).user;
const pathname = Astro.url.pathname;
const isPublic = isPublicRoute(pathname, publicRoutes);
const isProtectedPage = Boolean(user) && !isPublic;

const navLinks = [
    { href: "/", label: "Dashboard", roles: ["Admin"] },
    { href: "/redil", label: "Rediles", roles: ["Admin"] },
    { href: "/teacher", label: "Profesores", roles: ["Admin"] },
    { href: "/class", label: "Clases", roles: ["Admin", "Maestro"] },
    { href: "/my-redil", label: "Mi Redil", roles: ["Admin", "Maestro"] },
];

const visibleLinks = navLinks.filter((item) =>
    user ? item.roles.includes(user.role) : false,
);

---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/logo-comu.png" />
        <meta name="generator" content={Astro.generator} />
        <title>Redil App</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-[#F4F6F9] font-sans text-gray-800 antialiased min-h-screen flex flex-col"
    >
        {
            isProtectedPage && (
                <header class="bg-[#003366] text-white shadow-md sticky top-0 z-50">
                    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
                        <div class="flex items-center gap-6">
                            <a href="/">
                                <img
                                    src="/comu-app-logo.png"
                                    alt="logo"
                                    class="h-11 w-auto"
                                />
                            </a>

                            <nav class="hidden md:flex items-center gap-1">
                                {visibleLinks.map((item) => (
                                    <a
                                        href={item.href}
                                        class={`px-4 py-2 rounded-xl text-sm font-medium transition-colors ${
                                            pathname === item.href
                                                ? "bg-white/15 text-white"
                                                : "text-blue-100 hover:bg-white/10 hover:text-white"
                                        }`}
                                    >
                                        {item.label}
                                    </a>
                                ))}
                            </nav>
                        </div>

                        <div class="flex items-center gap-4">
                            <div class="relative">
                                <button
                                    id="userMenuBtn"
                                    class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-white/10 transition-colors"
                                    aria-haspopup="true"
                                    aria-expanded="false"
                                >
                                    <div class="hidden sm:block text-left">
                                        <p class="text-xs font-semibold leading-tight">
                                            {user?.name || "Usuario"}
                                        </p>
                                        <p class="text-[10px] text-blue-200 leading-tight">
                                            {user?.role || "Rol"}
                                        </p>
                                    </div>
                                    <svg
                                        class="chevron w-4 height-4 text-blue-200 transition-transform duration-200"
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M19 9l-7 7-7-7"
                                        />
                                    </svg>
                                </button>

                                <div
                                    id="userDropdown"
                                    class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg border border-gray-100 py-1 hidden [&.open]:block text-gray-700"
                                >
                                    <a
                                        href="/profile"
                                        class="block px-4 py-2.5 text-sm hover:bg-gray-50 font-medium"
                                    >
                                        Mi Perfil
                                    </a>
                                    <div class="border-t border-gray-100 my-1" />
                                    <button
                                        class="w-full text-left block px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 font-medium"
                                        onclick="window.location.href='/logout'"
                                    >
                                        Cerrar sesión
                                    </button>
                                </div>
                            </div>

                            <button
                                id="hamburgerBtn"
                                class="md:hidden p-2 rounded-xl hover:bg-white/10 transition-colors"
                                aria-label="Abrir menú"
                            >
                                <svg
                                    class="w-6 height-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M4 6h16M4 12h16M4 18h16"
                                    />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <nav
                        id="mobileNav"
                        class="md:hidden bg-[#002b5c] border-t border-blue-900/50 hidden [&.open]:block px-4 py-2 space-y-1 shadow-inner"
                    >
                        {visibleLinks.map((item) => (
                            <a
                                href={item.href}
                                class={`block px-4 py-2.5 rounded-xl text-sm font-medium transition-colors ${
                                    pathname === item.href
                                        ? "bg-white/15 text-white"
                                        : "text-blue-100 hover:bg-white/5"
                                }`}
                            >
                                {item.label}
                            </a>
                        ))}
                    </nav>
                </header>
            )
        }

        <main class="flex-grow flex flex-col">
            <slot />
        </main>

        <Toaster client:load position="top-right" />
    </body>
</html>

<script>
    const btn = document.getElementById("userMenuBtn");
    const dropdown = document.getElementById("userDropdown");
    const chevron = btn?.querySelector(".chevron");
    const hamburger = document.getElementById("hamburgerBtn");
    const mobileNav = document.getElementById("mobileNav");

    btn?.addEventListener("click", (e) => {
        e.stopPropagation();
        dropdown?.classList.toggle("open");
        chevron?.classList.toggle("rotate-180");
        const isOpen = dropdown?.classList.contains("open");
        btn.setAttribute("aria-expanded", String(isOpen));
    });

    document.addEventListener("click", () => {
        dropdown?.classList.remove("open");
        chevron?.classList.remove("rotate-180");
        btn?.setAttribute("aria-expanded", "false");
    });

    hamburger?.addEventListener("click", () => {
        mobileNav?.classList.toggle("open");
    });
</script>
