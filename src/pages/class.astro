---
import Layout from "../layouts/Layout.astro";
import ErrorCard from "../components/ui/ErrorCard.astro";
import { getClasses } from "../lib/api/class";
import { API_URL } from "../lib/api/client";
import ClassDashboard from "../components/classes/ClashDashboard";

export const prerender = false;

const cookie = Astro.request.headers.get("cookie");
const requestedPage = Math.max(
    1,
    Number(Astro.url.searchParams.get("page") ?? "1") || 1,
);

const { data, error, status } = await getClasses(
    cookie,
    new URLSearchParams({ page: String(requestedPage) }),
);
if (error) Astro.response.status = status;
---

<Layout>
    {
        data ? (
            <ClassDashboard
                client:load
                initialClasses={data}
                apiUrl={API_URL}
            />
        ) : (
            <ErrorCard title="Error cargando clases" message={error} />
        )
    }
</Layout>
