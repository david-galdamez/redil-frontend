---
import type { Locals } from "astro";
import Layout from "../../layouts/Layout.astro";
import RegisterClassForm from "../../components/classes/RegisterClassForm";
import ErrorCard from "../../components/ui/ErrorCard.astro";

const user = (Astro.locals as Locals).user;
const userProfile = (Astro.locals as Locals).userProfile;
---

<Layout>
  <div class="min-h-screen bg-[#F4F6F9] p-4 md:p-8">
    <div class="mx-auto max-w-4xl">
      {
        (userProfile?.redilId ?? user?.redil_id) ? (
          <div class="space-y-6">
            <header class="mb-6">
              <h1 class="text-2xl font-bold text-[#003366] md:text-3xl">Registrar clase</h1>
              <p class="mt-1 text-sm text-gray-500">
                Completa los datos para publicar una nueva clase.
              </p>
            </header>
            <RegisterClassForm client:load />
          </div>
        ) : (
          <div class="mx-auto max-w-2xl">
            <ErrorCard message="Debes estar asignado a un redil para crear una clase" />
          </div>
        )
      }
    </div>
  </div>
</Layout>
