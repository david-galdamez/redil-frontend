---
import type { Locals } from "astro";
import Layout from "../../layouts/Layout.astro";
import RegisterClassForm from "../../components/RegisterClassForm";
import { API_URL } from "../../lib/api/client";

const user = (Astro.locals as Locals).user;
---

<Layout>
    {
        user?.redil_id ? (
            <section class="page-shell">
                <header class="page-header">
                    <h1 class="page-title">Registrar clase</h1>
                    <p class="page-subtitle">
                        Completa los datos para publicar una nueva clase.
                    </p>
                </header>
                <RegisterClassForm client:load apiUrl={API_URL} />
            </section>
        ) : (
            <section class="page-shell">
                <div class="page-card">
                    <h1 class="page-title">Acceso denegado</h1>
                    <p class="page-subtitle">
                        Debes estar asignado a un redil para crear una clase.
                    </p>
                </div>
            </section>
        )
    }
</Layout>
