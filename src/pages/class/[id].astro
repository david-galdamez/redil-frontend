---
import ClassDetails from "../../components/classes/ClassDetails";
import ErrorCard from "../../components/ui/ErrorCard.astro";
import Layout from "../../layouts/Layout.astro";
import { getClassDetails } from "../../lib/api/class";
import { API_URL } from "../../lib/api/client";

export const prerender = false;

const { id } = Astro.params;
const cookie = Astro.request.headers.get("cookie");

const classDetails = await getClassDetails(id!, cookie);

if (classDetails.status === 404) return Astro.redirect("/not-found");
if (classDetails.error) Astro.response.status = classDetails.status;
---

<Layout>
    {
        classDetails?.data ? (
            <ClassDetails
                client:only
                apiUrl={API_URL}
                classDetails={classDetails.data!}
            />
        ) : (
            <ErrorCard message={classDetails.error} />
        )
    }
</Layout>
