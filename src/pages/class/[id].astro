---
import ClassDetails from "../../components/ClassDetails";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

const API_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";

const { id } = Astro.params;

let resData: ApiResponse<ClassDetailsDto> | null = null;
let errorMessage = null;

try {
    const res = await fetch(`${API_URL}/api/class/${id}`, {
        headers: {
            cookie: Astro.request.headers.get("cookie") || "",
        },
    });

    if (!res.ok) {
        if (res.status === 404) {
            return Astro.redirect("/not-found");
        }
        Astro.response.status = res.status;
        errorMessage = `Error ${res.status}: ${res.statusText}`;
    } else {
        resData = (await res.json()) as ApiResponse<ClassDetailsDto>;
    }
} catch (e) {
    console.error("Error fetching redil data:", e);
    Astro.response.status = 500;
    errorMessage =
        "Error conectando al servidor. Por favor, intenta nuevamente más tarde.";
}
---

<Layout>
    {
        resData?.success ? (
            <ClassDetails
                client:only
                apiUrl={API_URL}
                classDetails={resData.data!}
            />
        ) : (
            <section class="page-shell">
                <div class="page-card">
                    <h1 class="page-title">Error encontrando clase</h1>
                    <p class="page-subtitle">
                        {resData?.message ?? errorMessage}
                    </p>
                </div>
            </section>
        )
    }
</Layout>
