---
import Layout from "../layouts/Layout.astro";
import RedilDetailsTeachers from "../components/RedilDetailsTeachers.tsx";
import type { Locals } from "astro";

export const prerender = false;

const user = (Astro.locals as Locals).user;
const API_URL = import.meta.env.PUBLIC_API_URL;

let resData: ApiResponse<RedilDetailsDto> | null = null;
let errorMessage = null;

if (!user) {
    return (Astro.response.status = 401);
}

try {
    const res = await fetch(`${API_URL}/api/redil/${user?.redil_id}`, {
        headers: {
            cookie: Astro.request.headers.get("cookie") || "",
        },
    });

    if (!res.ok) {
        if (res.status === 404) {
            return Astro.redirect("/not-found");
        }
        Astro.response.status = res.status;
        errorMessage = `Error ${res.status}: ${res.statusText}`;
    } else {
        resData = (await res.json()) as ApiResponse<RedilDetailsDto>;
    }
} catch (e) {
    console.error("Error fetching redil data:", e);
    Astro.response.status = 500;
    errorMessage =
        "Error conectando al servidor. Por favor, intenta nuevamente más tarde.";
}
---

<Layout>
    {
        resData?.success ? (
            <RedilDetailsTeachers
                client:only
                id={user.redil_id!}
                redil={resData.data!}
                apiUrl={API_URL}
            />
        ) : (
            <section class="page-shell">
                <div class="page-card">
                    <h1 class="page-title">Error encontrando redil</h1>
                    <p class="page-subtitle">
                        {resData?.message ?? errorMessage}
                    </p>
                </div>
            </section>
        )
    }
</Layout>
