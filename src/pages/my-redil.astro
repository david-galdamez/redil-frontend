---
import Layout from "../layouts/Layout.astro";
import RedilDetailsTeachers from "../components/redil/RedilDetailsTeachers.tsx";
import type { Locals } from "astro";

import { getRedilDetails } from "../lib/api/redil";
import ErrorCard from "../components/ui/ErrorCard.astro";
export const prerender = false;

const user = (Astro.locals as Locals).user;
const token = (Astro.locals as Locals).token;
if (!user) {
    return (Astro.response.status = 401);
} else if (!user.redil_id) {
    return (Astro.response.status = 403);
}

const redilDetails = await getRedilDetails(user.redil_id, token!);
if (redilDetails.status === 404) return Astro.redirect("/not-found");
if (redilDetails.error) Astro.response.status = redilDetails.status;
---

<Layout>
    <div class="min-h-screen bg-[#F4F6F9] p-4 md:p-8">
        {
            redilDetails?.data ? (
                <div class="w-full">
                    <RedilDetailsTeachers
                        client:only
                        id={user.redil_id!}
                        redil={redilDetails.data!}
                    />
                </div>
            ) : (
                <div class="max-w-2xl mx-auto mt-8">
                    <ErrorCard
                        message={redilDetails.error}
                        status={redilDetails.status}
                    />
                </div>
            )
        }
    </div>
</Layout>
