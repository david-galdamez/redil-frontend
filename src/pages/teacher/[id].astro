---
import Layout from "../../layouts/Layout.astro";
import { API_URL } from "../../lib/api/client";
import TeacherDetails from "../../components/teachers/TeacherDetails";
import { getTeacherDetails, getRedils } from "../../lib/api/teachers";
import ErrorCard from "../../components/ui/ErrorCard.astro";

export const prerender = false;

const { id } = Astro.params;
const cookie = Astro.request.headers.get("cookie");

const [teacher, redils] = await Promise.all([
    getTeacherDetails(id!, cookie),
    getRedils(),
]);

if (teacher.status === 404) return Astro.redirect("/not-found");
if (teacher.error) Astro.response.status = teacher.status;
---

<Layout>
    <div class="min-h-screen bg-[#F4F6F9] p-4 md:p-8">
        <div class="max-w-5xl mx-auto">
            {
                teacher.data ? (
                    <div class="w-full">
                        <TeacherDetails
                            client:load
                            id={id! ?? ""}
                            teacher={teacher.data!}
                            redils={redils.data || []}
                            apiUrl={API_URL}
                        />
                    </div>
                ) : (
                    <div class="max-w-2xl mx-auto">
                        <ErrorCard
                            message={teacher.error}
                            status={teacher.status}
                        />
                    </div>
                )
            }
        </div>
    </div>
</Layout>
