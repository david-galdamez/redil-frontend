---
import Layout from "../../layouts/Layout.astro";
import TeacherDetails from "../../components/TeacherDetails";

export const prerender = false;

const { id } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

let resData: ApiResponse<TeacherDetailsDto> | null = null;
let redilsData: ApiResponse<RedilDto[]> | null = null;
let errorMessage = null;

try {
    const redilsRes = await fetch(`${API_URL}/api/redil`);
    if (redilsRes.ok) {
        redilsData = (await redilsRes.json()) as ApiResponse<RedilDto[]>;
    } else {
        Astro.response.status = redilsRes.status;
        errorMessage = `Error ${redilsRes.status}: ${redilsRes.statusText}`;
    }

    const res = await fetch(`${API_URL}/api/teacher/${id}`, {
        headers: {
            cookie: Astro.request.headers.get("cookie") || "",
            "Content-Type": "application/json",
        },
    });

    if (res.ok) {
        resData = (await res.json()) as ApiResponse<TeacherDetailsDto>;
    } else {
        Astro.response.status = res.status;
        errorMessage = `Error ${res.status}: ${res.statusText}`;
    }
} catch (e) {
    console.error("Error fetching teacher details:", e);
    Astro.response.status = 500;
    errorMessage =
        "Error conectando al servidor. Por favor, intenta nuevamente más tarde.";
}
---

<Layout>
    {
        resData?.success ? (
            <div>
                <TeacherDetails
                    client:load
                    id={id!}
                    teacher={resData.data!}
                    redils={redilsData?.data || []}
                    apiUrl={API_URL}
                />
            </div>
        ) : (
            <div>
                <h1>Error cargando detalles del profesor</h1>
                <p>
                    {errorMessage ||
                        "No se pudieron cargar los detalles del profesor."}
                </p>
            </div>
        )
    }
</Layout>
