---
import Layout from "../../layouts/Layout.astro";
import RegisterTeacherForm from "../../components/RegisterTeacherForm.tsx";

export const prerender = false;

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

let resRedils: ApiResponse<RedilListDto[]> | null = null;
let errorMessage = null;

try {
    const res = await fetch(`${API_URL}/api/redil`);
    if (!res.ok) {
        Astro.response.status = res.status;
        errorMessage = `Error ${res.status}: ${res.statusText}`;
    } else {
        resRedils = (await res.json()) as ApiResponse<RedilListDto[]>;
    }
} catch (e) {
    console.error("Error fetching data:", e);
    Astro.response.status = 500;
    errorMessage =
        "Error conectando al servidor. Por favor, intenta nuevamente más tarde.";
}
---

<Layout>
    <section class="page-shell">
        <header class="page-header">
            <h1 class="page-title">Registrar profesor</h1>
            <p class="page-subtitle">Completa el formulario para crear una cuenta docente.</p>
        </header>
        <RegisterTeacherForm
            client:load
            apiUrl={API_URL}
            rediles={resRedils?.data || []}
        />
    </section>
</Layout>
