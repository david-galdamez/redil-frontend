---
import Layout from "../../layouts/Layout.astro";
import RegisterTeacherForm from "../../components/teachers/RegisterTeacherForm.tsx";
import { getRedilsList } from "../../lib/api/redil";
import type { Locals } from "astro";

export const prerender = false;

const token = (Astro.locals as Locals).token;
const redils = await getRedilsList(token);
if (redils.error) Astro.response.status = redils.status;
---

<Layout>
  <div class="min-h-screen bg-[#F4F6F9] p-4 md:p-8">
    <div class="mx-auto max-w-4xl space-y-6">
      <header class="mb-6">
        <h1 class="text-2xl font-bold text-[#003366] md:text-3xl">Registrar profesor</h1>
        <p class="mt-1 text-sm text-gray-500">
          Completa el formulario para crear una cuenta docente.
        </p>
      </header>

      <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
        <RegisterTeacherForm client:load rediles={redils.data ?? []} />
      </div>
    </div>
  </div>
</Layout>
