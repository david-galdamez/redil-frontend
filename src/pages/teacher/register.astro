---
import Layout from "../../layouts/Layout.astro";
import RegisterTeacherForm from "../../components/RegisterTeacherForm.tsx";

export const prerender = false;

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

let resRedils: ApiResponse<RedilDto[]> | null = null;
let errorMessage = null;

try {
    const res = await fetch(`${API_URL}/api/redil`);
    if (!res.ok) {
        Astro.response.status = res.status;
        errorMessage = `Error ${res.status}: ${res.statusText}`;
    } else {
        resRedils = (await res.json()) as ApiResponse<RedilDto[]>;
    }
} catch (e) {
    console.error("Error fetching data:", e);
    Astro.response.status = 500;
    errorMessage =
        "Error conectando al servidor. Por favor, intenta nuevamente más tarde.";
}
---

<Layout>
    <h1>Registrar Profesor</h1>
    <RegisterTeacherForm
        client:load
        apiUrl={API_URL}
        rediles={resRedils?.data || []}
    />
</Layout>
