---
import Layout from "../layouts/Layout.astro";
import Pagination from "../components/Pagination.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";
const requestedPageParam = Number(Astro.url.searchParams.get("page") ?? "1");
const requestedPage =
    Number.isFinite(requestedPageParam) && requestedPageParam > 0
        ? Math.floor(requestedPageParam)
        : 1;
const search = Astro.url.searchParams.get("search") ?? "";

let resData: ApiResponse<PaginatedResponse<TeacherDto[]>> | null = null;
let errorMessage = null;
let paginatedTeachers: PaginatedResponse<TeacherDto[]> | null = null;

try {
    const params = new URLSearchParams({ page: String(requestedPage) });
    if (search) params.set("search", search);

    const res = await fetch(`${API_URL}/api/teacher?${params}`, {
        headers: {
            cookie: Astro.request.headers.get("cookie") || "",
            "Content-Type": "application/json",
        },
    });

    if (!res.ok) {
        Astro.response.status = res.status;
        errorMessage = `Error ${res.status}: ${res.statusText}`;
        const error = (await res.json()) as ApiResponse<
            PaginatedResponse<TeacherDto[]>
        >;
        console.log(error);
    } else {
        resData = (await res.json()) as ApiResponse<
            PaginatedResponse<TeacherDto[]>
        >;
        paginatedTeachers = resData.data ?? null;
    }
} catch (e) {
    console.error("Error fetching teacher data:", e);
    Astro.response.status = 500;
    errorMessage =
        "Error conectando al servidor. Por favor, intenta nuevamente más tarde.";
}
---

<Layout>
    {
        resData?.success ? (
            <section class="page-shell">
                <header class="page-header">
                    <h1 class="page-title">Dashboard de profesores</h1>
                    <p class="page-subtitle">
                        Gestiona docentes y revisa su redil asignada.
                    </p>
                    <p class="text-sm text-slate-500">
                        Pagina {paginatedTeachers?.currentPage ?? requestedPage}{" "}
                        de {paginatedTeachers?.totalPages ?? 1}
                        {" - "}
                        {paginatedTeachers?.totalRecords ?? 0} profesores en
                        total ({paginatedTeachers?.pageSize ?? 10} por pagina)
                    </p>
                </header>

                <form method="get" action="/teacher" class="flex gap-2 mb-4">
                    <input
                        class="input-base flex-1"
                        type="search"
                        name="search"
                        placeholder="Buscar profesor..."
                        value={search}
                    />
                </form>

                <div class="card-grid card-grid-balanced">
                    {paginatedTeachers?.data &&
                    paginatedTeachers.data.length > 0 ? (
                        paginatedTeachers.data.map((teacher) => (
                            <article
                                class="item-card item-card-balanced"
                                onclick={`window.location.href='/teacher/${teacher.id}'`}
                            >
                                <h2 class="text-lg font-semibold text-slate-900">
                                    {teacher.name}
                                </h2>
                                <p class="mt-auto text-sm text-slate-600">
                                    Redil: {teacher.redilName}
                                </p>
                            </article>
                        ))
                    ) : (
                        <p class="text-sm text-slate-600">
                            {search
                                ? `No se encontraron profesores con "${search}"`
                                : "No hay profesores registrados"}
                        </p>
                    )}
                </div>

                <Pagination
                    currentPage={
                        paginatedTeachers?.currentPage ?? requestedPage
                    }
                    totalPages={paginatedTeachers?.totalPages ?? 1}
                    basePath="/teacher"
                    query={Astro.url.searchParams}
                />
                <div class="mt-6">
                    <button
                        class="btn-primary w-full sm:w-fit"
                        onclick={`window.location.href='/teacher/register'`}
                    >
                        Registrar profesor
                    </button>
                </div>
            </section>
        ) : (
            <section class="page-shell">
                <div class="page-card">
                    <h1 class="page-title">Error cargando profesores</h1>
                    <p class="page-subtitle">
                        {errorMessage ||
                            "No se pudieron cargar los profesores."}
                    </p>
                </div>
            </section>
        )
    }
</Layout>
<script>
    const input = document.querySelector<HTMLInputElement>(
        'input[name="search"]',
    );
    const form = input?.closest("form");
    let timer: ReturnType<typeof setTimeout>;

    input?.addEventListener("input", () => {
        clearTimeout(timer);
        timer = setTimeout(() => form?.submit(), 500);
    });
</script>
