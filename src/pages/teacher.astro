---
import type { Locals } from "astro";
import Layout from "../layouts/Layout.astro";
import TeacherDashboard from "../components/teachers/TeacherDashboard";
import ErrorCard from "../components/ui/ErrorCard.astro";
import { getTeachers } from "../lib/api/teachers";

export const prerender = false;

const token = (Astro.locals as Locals).token;
const requestedPage = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const search = Astro.url.searchParams.get("search") ?? "";
const redilId = Astro.url.searchParams.get("redilId") ?? "";
const roleId = Astro.url.searchParams.get("roleId") ?? "";
const params = new URLSearchParams({ page: String(requestedPage) });
if (search) params.set("search", search);
if (redilId) params.set("redilId", redilId);
if (roleId) params.set("roleId", roleId);
const { data, error, status } = await getTeachers(token, params);
if (error) Astro.response.status = status;
---

<Layout>
  <div class="min-h-screen bg-[#F4F6F9] p-4 md:p-8">
    {
      data ? (
        <TeacherDashboard
          client:load
          initialTeachers={data}
          initialSearch={search}
          initialRedilId={redilId}
          initialRoleId={roleId}
        />
      ) : (
        <div class="mx-auto max-w-2xl">
          <ErrorCard title="Error cargando profesores" message={error} status={status} />
        </div>
      )
    }
  </div>
</Layout>
