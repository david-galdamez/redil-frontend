---
import Layout from "../layouts/Layout.astro";
import TeacherDashboard from "../components/teachers/TeacherDashboard";
import ErrorCard from "../components/ui/ErrorCard.astro";
import { getTeachers } from "../lib/api/teachers";
import { API_URL } from "../lib/api/client";

export const prerender = false;

const cookie = Astro.request.headers.get("cookie");

const requestedPage = Math.max(
    1,
    Number(Astro.url.searchParams.get("page") ?? "1") || 1,
);
const search = Astro.url.searchParams.get("search") ?? "";
const params = new URLSearchParams({ page: String(requestedPage) });
if (search) params.set("search", search);

const { data, error, status } = await getTeachers(cookie, params);
if (error) Astro.response.status = status;
---

<Layout>
    {
        data ? (
            <TeacherDashboard
                client:load
                initialTeachers={data}
                initialSearch={search}
                apiUrl={API_URL}
            />
        ) : (
            <ErrorCard
                title="Error cargando profesores"
                message={error}
                status={status}
            />
        )
    }
</Layout>
