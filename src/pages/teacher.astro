---
import Layout from "../layouts/Layout.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

let resData: ApiResponse<TeacherDto[]> | null = null;
let errorMessage = null;

try {
    const res = await fetch(`${API_URL}/api/teacher`, {
        headers: {
            cookie: Astro.request.headers.get("cookie") || "",
            "Content-Type": "application/json",
        },
    });

    if (!res.ok) {
        Astro.response.status = res.status;
        errorMessage = `Error ${res.status}: ${res.statusText}`;
    } else {
        resData = (await res.json()) as ApiResponse<TeacherDto[]>;
    }

} catch (e) {
    console.error("Error fetching teacher data:", e);
    Astro.response.status = 500;
    errorMessage =
        "Error conectando al servidor. Por favor, intenta nuevamente más tarde.";
}
---

<Layout>
    {
        resData?.success ? 
        (
            <h1>Dashboard de profesores</h1>
            <p>
                Bienvenido, aqui podras gestionar a los profesores registrados en el
                sistema, asignarles clases y ver su desempeño.
            </p>
            <div class="teacher-list-container">
                {
                resData.data ? (
                resData.data?.map((teacher) => (
                    <div class="teacher-card" onclick={`window.location.href='/teacher/${teacher.id}'`}>
                        <h2>{teacher.name}</h2>
                            <p>Redil: {teacher.redilName}</p>
                        </div>
                    ))
                ) : (
                    <p>No hay profesores registrados</p>
                )
                }
                <div>
                    <button onclick={`window.location.href='/teacher/register'`}>Registrar Profesor</button>
                </div>
            </div>
        )
        :
        (
            <div>
                <h1>Error cargando profesores</h1>
                <p>{errorMessage || "No se pudieron cargar los profesores."}</p>
            </div>
        )
    }
</Layout>
