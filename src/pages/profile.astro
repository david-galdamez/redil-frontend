---
import type { UserDetailsDto } from "../types/user";
import Layout from "../layouts/Layout.astro";
import ProfileDetails from "../components/profile/ProfileDetails";
import { getProfile } from "../lib/api/auth";
import { API_URL } from "../lib/api/client";
import ErrorCard from "../components/ui/ErrorCard.astro";

const cookie = Astro.request.headers.get("cookie");
const profile = await getProfile(cookie);

if (profile.error) Astro.response.status = profile.status;
---

<Layout>
    <div class="min-h-screen bg-[#F4F6F9] md:p-8">
        <div class="max-w-4xl mx-auto">
            {
                profile.data ? (
                    <ProfileDetails
                        client:load
                        user={profile.data!}
                        apiUrl={API_URL}
                    />
                ) : (
                    <div class="p-4">
                        <ErrorCard
                            message={profile.error}
                            status={profile.status}
                        />
                    </div>
                )
            }
        </div>
    </div>
</Layout>
