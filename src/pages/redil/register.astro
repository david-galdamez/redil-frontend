---
import RegisterRedilForm from "../../components/redil/RegisterRedilForm";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <div class="min-h-screen bg-[#F4F6F9] p-4 md:p-8">
    <div class="mx-auto max-w-4xl space-y-6">
      <header class="mb-6">
        <h1 class="text-2xl font-bold text-[#003366] md:text-3xl">Registrar redil</h1>
        <p class="mt-1 text-sm text-gray-500">
          Crea un nuevo redil para organizar profesores y clases.
        </p>
      </header>

      <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
        <RegisterRedilForm client:load />
      </div>
    </div>
  </div>
</Layout>
