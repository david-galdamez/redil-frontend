---
import RegisterRedilForm from "../../components/redil/RegisterRedilForm";
import Layout from "../../layouts/Layout.astro";
import { API_URL } from "../../lib/api/client";
---

<Layout>
    <div class="min-h-screen bg-[#F4F6F9] p-4 md:p-8">
        <div class="max-w-4xl mx-auto space-y-6">
            <header class="mb-6">
                <h1 class="text-2xl md:text-3xl font-bold text-[#003366]">
                    Registrar redil
                </h1>
                <p class="text-sm text-gray-500 mt-1">
                    Crea un nuevo redil para organizar profesores y clases.
                </p>
            </header>

            <div
                class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100"
            >
                <RegisterRedilForm client:load apiUrl={API_URL} />
            </div>
        </div>
    </div>
</Layout>
