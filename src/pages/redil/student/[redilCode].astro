---
import Layout from "../../../layouts/Layout.astro";
import RedilRegisterForm from "../../../components/StudentRegisterForm.tsx";
import { getRedilByCode } from "../../../lib/api/redil";
import { getGroups } from "../../../lib/api/groups";
import { API_URL } from "../../../lib/api/client";
import ErrorCard from "../../../components/ui/ErrorCard.astro";

export const prerender = false;

const { redilCode } = Astro.params;

const [redils, groups] = await Promise.all([
    getRedilByCode(redilCode!),
    getGroups(),
]);

if (redils.status === 404) return Astro.redirect("/not-found");
if (redils.error) Astro.response.status = redils.status;
---

<Layout>
    {
        redils?.data ? (
            <section class="page-shell">
                <header class="page-header">
                    <h1 class="page-title">
                        Inscripcion a {redils?.data?.name}
                    </h1>
                    <p class="page-subtitle">{redils?.data?.description}</p>
                </header>

                <div class="page-card form-card-compact mb-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <p class="text-sm text-slate-600">
                            Completa el formulario para registrar tu asistencia
                            al redil.
                        </p>
                    </div>
                </div>

                <RedilRegisterForm
                    client:load
                    redilCode={redilCode || ""}
                    apiUrl={API_URL}
                    groups={groups?.data || []}
                />
            </section>
        ) : (
            <ErrorCard message={redils.error} />
        )
    }
</Layout>
