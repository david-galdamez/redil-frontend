---
import Layout from "../../../layouts/Layout.astro";
import RedilRegisterForm from "../../../components/StudentRegisterForm.tsx";

export const prerender = false;

const { redilCode } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL;

let resData: ApiResponse<RedilDto> | null = null;
let resGroups: ApiResponse<GroupDto[]> | null = null;
let errorMessage = null;

try {
    const res = await fetch(`${API_URL}/api/redil/code/${redilCode}`);
    const groupsRes = await fetch(`${API_URL}/api/groups`);

    if (!res.ok) {
        if (res.status === 404) {
            return Astro.redirect("/not-found");
        }
        Astro.response.status = res.status;
        errorMessage = `Error ${res.status}: ${res.statusText}`;
    } else {
        resData = (await res.json()) as ApiResponse<RedilDto>;
    }

    if (!groupsRes.ok) {
        Astro.response.status = groupsRes.status;
        errorMessage = `Error ${groupsRes.status}: ${groupsRes.statusText}`;
    } else {
        resGroups = (await groupsRes.json()) as ApiResponse<GroupDto[]>;
    }
} catch (e) {
    console.error("Error fetching redil data:", e);
    Astro.response.status = 500;
    errorMessage =
        "Error conectando al servidor. Por favor, intenta nuevamente más tarde.";
}
---

<Layout>
    {
        resData?.success ? (
            <section class="page-shell">
                <header class="page-header">
                    <h1 class="page-title">
                        Inscripcion a {resData?.data?.name}
                    </h1>
                    <p class="page-subtitle">{resData?.data?.description}</p>
                </header>

                <div class="page-card form-card-compact mb-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <p class="text-sm text-slate-600">
                            Completa el formulario para registrar tu asistencia
                            al redil.
                        </p>
                        {/* <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700">
                            {resGroups?.data?.length || 0} grupos disponibles
                        </span> */}
                    </div>
                </div>

                <RedilRegisterForm
                    client:load
                    redilCode={redilCode || ""}
                    apiUrl={API_URL}
                    groups={resGroups?.data || []}
                />
            </section>
        ) : (
            <section class="page-shell">
                <div class="page-card">
                    <h1 class="page-title">Error encontrando redil</h1>
                    <p class="page-subtitle">
                        {resData?.message ?? errorMessage}
                    </p>
                </div>
            </section>
        )
    }
</Layout>
