---
import Layout from "../../layouts/Layout.astro";
import RedilDetails from "../../components/RedilDetails.tsx";
import { API_URL } from "../../lib/api/client";
import { getRedilDetails } from "../../lib/api/redil";
import { redirectToDefaultLocale } from "astro:i18n";
import ErrorCard from "../../components/ui/ErrorCard.astro";

export const prerender = false;

const { id } = Astro.params;
const cookie = Astro.request.headers.get("cookie");

const redil = await getRedilDetails(id!, cookie);
if (redil.status === 404) return Astro.redirect("/not-found");
if (redil.error) Astro.response.status = redil.status;
---

<Layout>
    {
        redil?.data ? (
            <RedilDetails
                client:only
                id={id!}
                redil={redil.data!}
                apiUrl={API_URL}
            />
        ) : (
            <ErrorCard message={redil.error} />
        )
    }
</Layout>
