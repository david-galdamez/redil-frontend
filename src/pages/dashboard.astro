---
import type { Locals } from "astro";
import Layout from "../layouts/Layout.astro";

const user = (Astro.locals as Locals).user;
---

<Layout>
    <section class="page-shell">
        <div class="page-card">
            <h1 class="page-title">Dashboard {user?.role}</h1>
            <p class="page-subtitle">Bienvenido. Usa el menu de navegacion para gestionar rediles, profesores y clases.</p>
        </div>
    </section>
</Layout>
