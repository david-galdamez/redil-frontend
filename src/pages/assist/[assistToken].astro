---
import AssistClassDetails from "../../components/classes/AssistClassDetails";
import Layout from "../../layouts/Layout.astro";
import { getRedilAssistInfo } from "../../lib/api/redil";

import ErrorCard from "../../components/ui/ErrorCard.astro";

export const prerender = false;

const { assistToken } = Astro.params;

const assistDetails = await getRedilAssistInfo(assistToken!);
if (assistDetails.status === 404) return Astro.redirect("/not-found");
if (assistDetails.error) Astro.response.status = assistDetails.status;
---

<Layout>
  <div class="min-h-screen bg-[#F4F6F9] p-4 md:p-8">
    <div class="mx-auto max-w-6xl">
      {
        assistDetails?.data ? (
          <div class="w-full">
            <AssistClassDetails
              client:load
              assistClass={assistDetails.data!}
              attendanceToken={assistToken!}
              phones={assistDetails.data.phones}
            />
          </div>
        ) : (
          <div class="mx-auto max-w-2xl">
            <ErrorCard message={assistDetails.error} status={assistDetails.status} />
          </div>
        )
      }
    </div>
  </div>
</Layout>
