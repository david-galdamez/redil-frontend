---
import AssistClassDetails from "../../components/classes/AssistClassDetails";
import Layout from "../../layouts/Layout.astro";
import { getRedilAssistInfo } from "../../lib/api/redil";
import { API_URL } from "../../lib/api/client";
import ErrorCard from "../../components/ui/ErrorCard.astro";

export const prerender = false;

const { assistToken } = Astro.params;

const assistDetails = await getRedilAssistInfo(assistToken!);
if(assistDetails.status === 404) return Astro.redirect("/not-found");
if(assistDetails.error) Astro.response.status = assistDetails.status;

---

<Layout>
    {
        assistDetails?.data ? (
            <AssistClassDetails client:load apiUrl={API_URL}, assistClass={assistDetails.data!} attendanceToken={assistToken!} emails={assistDetails.data?.emails!} />
        ) : (
            <ErrorCard message={assistDetails.error} />
        )
    }
</Layout>
