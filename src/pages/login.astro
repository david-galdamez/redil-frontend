---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div>
        <h1>Login</h1>

        <form id="login-form">
            <div>
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" required />
                <small class="error" id="email-error"></small>
            </div>

            <div>
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required />
                <small class="error" id="password-error"></small>
            </div>

            <small class="error" id="general-error"></small>

            <button type="submit">Login</button>
        </form>
    </div>

    <script>
        const API_URL =
            import.meta.env.PUBLIC_API_URL || "http://localhost:4000";
        const form = document.querySelector("form");

        const emailError = document.getElementById("email-error")!;
        const passwordError = document.getElementById("password-error")!;
        const generalError = document.getElementById("general-error")!;

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();

            emailError.textContent = "";
            passwordError.textContent = "";
            generalError.textContent = "";

            const formData = new FormData(form);
            const email = formData.get("email");
            const password = formData.get("password");

            try {
                const response = await fetch(`${API_URL}/api/auth/login`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    credentials: "include",
                    body: JSON.stringify({ email, password }),
                });

                const data = await response.json();

                if (response.status === 400 && data.errors) {
                    data.errors.forEach((err: Error) => {
                        if (err.field.toLowerCase() === "email") {
                            emailError.textContent = err.message;
                        }
                        if (err.field.toLowerCase() === "password") {
                            passwordError.textContent = err.message;
                        }
                    });
                    return;
                }

                if (response.status === 401) {
                    generalError.textContent =
                        data.message || "Credenciales incorrectas";
                    return;
                }

                if (!response.ok || !data.success) {
                    generalError.textContent =
                        data.message || "Ocurrió un error inesperado";
                    return;
                }

                window.location.href = "/dashboard";
            } catch (error) {
                console.error("Error during login:", error);
                generalError.textContent =
                    "No se pudo conectar con el servidor.";
            }
        });
    </script>
</Layout>
