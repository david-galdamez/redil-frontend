---
import LoginForm from "../components/LoginForm";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="flex min-h-screen flex-col items-center justify-center bg-[#F4F6F9] p-4">
    <div class="w-full max-w-md rounded-2xl border border-gray-100 bg-white p-8 shadow-md">
      <header class="mb-6 text-center">
        <div
          class="mb-4 inline-flex items-center justify-center rounded-xl px-4 py-2 text-xl font-black tracking-wider"
        >
          <img src="/comu-app-logo.png" alt="logo" class="h-18 w-auto" />
        </div>
        <h1 class="text-2xl font-bold text-[#003366]">Iniciar sesión</h1>
        <p class="mt-1 text-sm text-gray-500">
          Accede a tu cuenta para administrar tu información.
        </p>
      </header>

      <LoginForm client:load />
    </div>
  </div>
</Layout>
