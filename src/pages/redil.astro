---
import Layout from "../layouts/Layout.astro";
import RedilList from "../components/redil/RedilList";
import { getRedilsList } from "../lib/api/redil";
import ErrorCard from "../components/ui/ErrorCard.astro";

const redilList = await getRedilsList();

if (redilList.error) Astro.response.status = redilList.status;
---

<Layout>
    {
        redilList?.data ? (
            <section class="page-shell">
                <header class="page-header">
                    <h1 class="page-title">Dashboard de rediles</h1>
                    <p class="page-subtitle">
                        Gestiona las rediles registradas en el sistema.
                    </p>
                </header>

                <RedilList client:load redils={redilList.data ?? []} />

                <div class="mt-6">
                    <button
                        class="btn-primary w-full sm:w-fit"
                        onclick="window.location.href='/redil/register'"
                    >
                        Registrar redil
                    </button>
                </div>
            </section>
        ) : (
            <ErrorCard message={redilList.error} status={redilList.status} />
        )
    }
</Layout>
