---
import Layout from "../layouts/Layout.astro";
import RedilList from "../components/redil/RedilList";
import { getRedilsList } from "../lib/api/redil";
import ErrorCard from "../components/ui/ErrorCard.astro";
const redilList = await getRedilsList();

if (redilList.error) Astro.response.status = redilList.status;
---

<Layout>
    <div class="min-h-screen bg-[#F4F6F9] p-4 md:p-8">
        {
            redilList?.data ? (
                <div class="w-full space-y-6">
                    <header class="mb-6">
                        <h1 class="text-2xl md:text-3xl font-bold text-[#003366]">
                            Dashboard de rediles
                        </h1>
                        <p class="text-sm text-gray-500 mt-1">
                            Gestiona las rediles registradas en el sistema de
                            manera centralizada.
                        </p>
                    </header>

                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                        <RedilList client:load redils={redilList.data ?? []} />
                    </div>

                    <div class="mt-6 flex justify-end">
                        <button
                            class="w-full sm:w-auto px-6 py-3 bg-[#003366] hover:bg-[#002244] text-white font-medium rounded-xl shadow-sm transition-all duration-200 flex items-center justify-center gap-2 text-sm"
                            onclick="window.location.href='/redil/register'"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <>
                                    <path d="M5 12h14" />
                                    <path d="M12 5v14" />
                                </>
                            </svg>
                            Registrar redil
                        </button>
                    </div>
                </div>
            ) : (
                <div class="max-w-2xl mx-auto">
                    <ErrorCard
                        message={redilList.error}
                        status={redilList.status}
                    />
                </div>
            )
        }
    </div>
</Layout>
