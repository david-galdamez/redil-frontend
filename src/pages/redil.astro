---
import Layout from "../layouts/Layout.astro";
import RedilList from "../components/redil/RedilList";
import { getRedilsList } from "../lib/api/redil";
import ErrorCard from "../components/ui/ErrorCard.astro";
import type { Locals } from "astro";

const token = (Astro.locals as Locals).token;
const redilList = await getRedilsList(token);

if (redilList.error) Astro.response.status = redilList.status;
---

<Layout>
  <div class="min-h-screen bg-[#F4F6F9] p-4 md:p-8">
    {
      redilList?.data ? (
        <div class="w-full space-y-6">
          <header class="mb-6">
            <h1 class="text-2xl font-bold text-[#003366] md:text-3xl">Dashboard de rediles</h1>
            <p class="mt-1 text-sm text-gray-500">
              Gestiona las rediles registradas en el sistema de manera centralizada.
            </p>
          </header>

          <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <RedilList client:load redils={redilList.data ?? []} />
          </div>

          <div class="mt-6 flex justify-end">
            <button
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#003366] px-6 py-3 text-sm font-medium text-white shadow-sm transition-all duration-200 hover:bg-[#002244] sm:w-auto"
              onclick="window.location.href='/redil/register'"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M5 12h14" />
                  <path d="M12 5v14" />
                </>
              </svg>
              Registrar redil
            </button>
          </div>
        </div>
      ) : (
        <div class="mx-auto max-w-2xl">
          <ErrorCard message={redilList.error} status={redilList.status} />
        </div>
      )
    }
  </div>
</Layout>
