---
import type { Locals } from "astro";
import Layout from "../layouts/Layout.astro";
import TeacherStats from "../components/stats/TeacherStats";

const user = (Astro.locals as Locals).user;
---

<Layout>
  <div class="min-h-screen bg-[#F4F6F9]">
    <div class="mx-auto max-w-7xl px-4 py-6 md:py-8">
      <div
        class="relative mb-8 flex flex-col items-start justify-between gap-4 overflow-hidden rounded-2xl bg-gradient-to-r from-[#FFF1E0] to-[#F3D5B5] p-6 shadow-sm md:flex-row md:items-center md:p-8"
      >
        <div class="z-10 max-w-xl">
          <div class="mb-2 flex items-center gap-3">
            <span class="rounded-full bg-white/80 p-2 text-[#D4A373] shadow-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"
                ></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"
                ></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path
                  d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg
              >
            </span>
            <h1 class="text-2xl font-bold text-[#003366] md:text-3xl">
              ¡Buenas tardes {user?.name || `Usuario`}!
            </h1>
          </div>
          <p class="text-sm leading-relaxed text-gray-700 md:text-base">
            Bienvenid@ a la plataforma de rediles de la Comunidad Católica El Salvador del Mundo:
            gestiona rediles, maestros y clases en un solo lugar.
          </p>
        </div>

        <div
          class="pointer-events-none absolute top-0 right-0 bottom-0 hidden w-1/3 bg-[url('/assets/church-silhouette.png')] bg-contain bg-right-bottom bg-no-repeat opacity-20 lg:block"
        >
        </div>
      </div>
      {
        user?.role === "Admin" && (
          <div class="space-y-4 rounded-2xl border border-gray-100/80 bg-white p-6 shadow-sm">
            <div class="border-b border-gray-100 pb-3">
              <h2 class="text-lg font-bold text-[#003366]">Estadísticas de asistencia</h2>
              <p class="text-xs text-gray-500">Métricas globales actualizadas en tiempo real.</p>
            </div>
            <div class="pt-2">
              <TeacherStats client:load />
            </div>
          </div>
        )
      }
    </div>
  </div>
</Layout>
