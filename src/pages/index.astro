---
import type { Locals } from "astro";
import Layout from "../layouts/Layout.astro";
import TeacherStats from "../components/stats/TeacherStats";
import { API_URL } from "../lib/api/client";

const user = (Astro.locals as Locals).user;
---

<Layout>
	<section class="page-shell">
		<header class="page-header">
			<h1 class="page-title">Dashboard {user?.role}</h1>
			<p class="page-subtitle">
				Bienvenido. Usa el menú de navegación para gestionar rediles,
				profesores y clases.
			</p>
		</header>

		{
			user?.role === "Admin" && (
				<div class="page-card space-y-4">
					<h2 class="text-base font-medium text-slate-700">
						Estadísticas de asistencia
					</h2>
					<TeacherStats apiUrl={API_URL} client:load />
				</div>
			)
		}
	</section>
</Layout>
