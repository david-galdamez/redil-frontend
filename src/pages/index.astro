---
import type { Locals } from "astro";
import Layout from "../layouts/Layout.astro";
import TeacherStats from "../components/stats/TeacherStats";

const user = (Astro.locals as Locals).user;
---

<Layout>
	<div class="min-h-screen bg-[#F4F6F9]">
		<div class="max-w-7xl mx-auto px-4 py-6 md:py-8">
			<div
				class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-[#FFF1E0] to-[#F3D5B5] p-6 md:p-8 shadow-sm mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
			>
				<div class="max-w-xl z-10">
					<div class="flex items-center gap-3 mb-2">
						<span
							class="p-2 bg-white/80 rounded-full text-[#D4A373] shadow-sm"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><circle cx="12" cy="12" r="4"></circle><path
									d="M12 2v2"></path><path d="M12 20v2"
								></path><path d="m4.93 4.93 1.41 1.41"
								></path><path d="m17.66 17.66 1.41 1.41"
								></path><path d="M2 12h2"></path><path
									d="M20 12h2"></path><path
									d="m6.34 17.66-1.41 1.41"></path><path
									d="m19.07 4.93-1.41 1.41"></path></svg
							>
						</span>
						<h1
							class="text-2xl md:text-3xl font-bold text-[#003366]"
						>
							¡Buenas tardes {user?.name || `Usuario`}!
						</h1>
					</div>
					<p
						class="text-gray-700 text-sm md:text-base leading-relaxed"
					>
						Bienvenid@ a la plataforma de rediles de la Comunidad
						Católica El Salvador del Mundo: gestiona rediles,
						maestros y clases en un solo lugar.
					</p>
				</div>

				<div
					class="hidden lg:block absolute right-0 bottom-0 top-0 w-1/3 opacity-20 pointer-events-none bg-[url('/assets/church-silhouette.png')] bg-contain bg-right-bottom bg-no-repeat"
				>
				</div>
			</div>
			{
				user?.role === "Admin" && (
					<div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100/80 space-y-4">
						<div class="border-b border-gray-100 pb-3">
							<h2 class="text-lg font-bold text-[#003366]">
								Estadísticas de asistencia
							</h2>
							<p class="text-xs text-gray-500">
								Métricas globales actualizadas en tiempo real.
							</p>
						</div>
						<div class="pt-2">
							<TeacherStats client:load />
						</div>
					</div>
				)
			}
		</div>
	</div>
</Layout>
